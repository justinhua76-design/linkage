# Copy to .env and replace every value. Never commit .env.
APP_ENV=development
POSTGRES_USER=bioage
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bioage

# Static bearer tokens (Sprint 1 only; replace with OIDC before any non-local use).
# Roles: admin | clinician | researcher | viewer. Tokens must be >= 16 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKENS=[{"token":"REPLACE-clinician-token-xxxxxxxx","user_id":"dev-clinician","role":"clinician"},{"token":"REPLACE-admin-token-xxxxxxxxxxxx","user_id":"dev-admin","role":"admin"}]

# Token the Next.js server uses when proxying to the API (kept server-side only).
FRONTEND_BACKEND_TOKEN=REPLACE-clinician-token-xxxxxxxx

CORS_ORIGINS=http://localhost:3000
# CRP below limit of detection: lod_div_sqrt2 | lod | reject
CRP_LOD_POLICY=lod_div_sqrt2
MAX_LAB_SPAN_DAYS=30
LOG_LEVEL=INFO
